{
  "name": "alex-os-obsidian",
  "version": "0.1.1",
  "private": true,
  "description": "A live, local-first personal operating dashboard rendered inside Obsidian Home.md.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alex-slovakia/alex-os.git"
  },
  "homepage": "https://github.com/alex-slovakia/alex-os#readme",
  "bugs": "https://github.com/alex-slovakia/alex-os/issues",
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "dashboard",
    "local-first",
    "productivity",
    "google-calendar"
  ],
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "lint": "eslint . --max-warnings=0",
